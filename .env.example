# 복사해서 .env 로 사용. 모든 키는 app/config.py 의 Settings 필드와 대응.
# ⚠️ 여기 값을 .env 에 넣으면 코드 기본값을 덮어씁니다 — 기본값이 이미 최적인
# 항목은 넣지 않는 것이 안전합니다 (특히 유사도 임계값들).

# ── 다이얼 (08-realtime-detection.md) ──
#COLLECT_INTERVAL_SEC=60
#ANALYZE_INTERVAL_SEC=60
#WINDOW_HOURS=24

# ── 수집 (DB1 = etl_dcinside) ──
#COLLECTOR_BACKEND=dcinside
#DCINSIDE_DB_PATH=/Users/mcn1ne/etl_dcinside/dcinside.db
#DCINSIDE_BACKFILL_HOURS=72

# ── ① 임베딩 (2026-07-05부터 KURE-v1 — 한국어 특화, 1024차원) ──
#EMBEDDING_BACKEND=sentence-transformers
#EMBEDDING_MODEL=nlpai-lab/KURE-v1
# ⚠️ 임베딩 모델을 바꾸면 유사도 스케일이 달라져 아래 임계값 전부 재캘리브레이션 +
#    전량 재임베딩 + 카테고리·주제 재구축이 필요합니다.

# ── ② 카테고리 (대분류) — 주 배정자는 LLM ──
# 벡터 빠른 경로는 근사중복(도배) 지름길일 뿐. 실측상 대분류 판정은 벡터로 불가.
#CATEGORY_ASSIGN_SIM=0.80
#CATEGORY_CANDIDATES_K=5
#CATEGORY_CENTROID_MAX_N=50

# ── 주제 (미세 이슈, 버스트·알림의 단위) — 벡터 담당 ──
# KURE-v1 + 24시간 창 기준 캘리브레이션 (유사도 실험 페이지로 튜닝)
#TOPIC_LINK_SIM=0.70
#TOPIC_MIN_SIZE=4
#TOPIC_MATCH_SIM=0.85

# ── HDBSCAN 안전망 ──
#CLUSTERING_BACKEND=hdbscan
#MIN_CLUSTER_SIZE=5
# ⚠️ 5는 라이브 안전망(recluster-check)용. 오프라인 정답셋 배치
#    (scripts/build_gold_dataset.py)는 이 값을 쓰지 않고 자체 기본 10을 쓴다
#    (--min-cluster-size로 변경). 48h 실측: 5 이하 → 전체가 잡담 블랙홀 1개,
#    10 → 조밀한 동향 시드만 남고 나머지는 구출 단계가 회수, 15 → 클러스터 0개.

# ── ③ 요약 ──
#SUMMARIZER_BACKEND=mlx
#SUMMARY_SNIPPET_CHARS=2000

# ── Gemma 글 분석·분류 워커 (큐 기반) ──
#GEMMA_ANALYSIS_ENABLED=true
#GEMMA_BATCH_SIZE=10
#GEMMA_WORKER_INTERVAL_SEC=20

# ── LLM 생성 토큰 상한 (사고+답변 합산 — cap이라 크게 잡아도 무방) ──
#SUMMARIZER_MAX_TOKENS=4000
#CATEGORIZER_MAX_TOKENS=300
#RECLASSIFY_EXTRA_TOKENS=3000
#JUDGE_MAX_TOKENS=8

# ── ④ 알림 판단 (보유 파인튜닝 4B) ──
#JUDGE_BACKEND=mlx
#JUDGE_ADAPTER_PATH=/Users/mcn1ne/GreatestStep/adapters3
# adapters3 머지(mlx_lm.fuse) 완료 후에는 아래 한 줄만 설정:
#JUDGE_FUSED_PATH=/Users/mcn1ne/GreatestStep/gemma4-notify3-hf
